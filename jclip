#!/usr/bin/env bash
# jclip - clip a section of a YouTube or X/Twitter video to mp4 (or mp3).
# usage: jclip <url|file> [<start> <end>] [--mp3]   e.g. jclip URL 0:20 1:20
#        no start/end = full video
#        jclip --dir <path>   set default output dir (default ~/Videos; env JCLIP_DIR overrides)
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/jclip/dir"
[[ "${1:-}" == "--dir" && -n "${2:-}" ]] && { mkdir -p "${CONF%/*}" "$2"; (cd "$2" && pwd) >"$CONF"; echo "jclip: output dir set to $(<"$CONF")"; exit 0; }
OUT_DIR="${JCLIP_DIR:-$( [[ -s "$CONF" ]] && cat "$CONF" || echo "$HOME/Videos")}"
CACHE="$OUT_DIR/.cache"

[[ $# -ge 1 ]] || { sed -n '2,5p' "$0" | sed 's/^# //'; exit 1; }
url=$1 mp3=0; shift
[[ "${*: -1}" == "--mp3" ]] && { mp3=1; set -- "${@:1:$#-1}"; }
start=${1:-} end=${2:-}
for t in yt-dlp ffmpeg; do command -v "$t" >/dev/null || { echo "jclip: missing $t" >&2; exit 1; }; done
mkdir -p "$CACHE"

# Download full video once per id; sectioned downloads truncate audio.
# --playlist-items 1: tweets with several videos are a playlist; take the first.
yt() { yt-dlp --playlist-items 1 "$@"; }
clean() { tr -c 'A-Za-z0-9._-' '_' | sed 's/_*$//' | cut -c1-60; }
if [[ -f "$url" ]]; then  # local file: clip it directly, no download
  full=$url title=$(basename "${url%.*}" | clean)
else
  id=$(yt --get-id "$url")
  title=$(yt --get-title "$url" | clean)
  full="$CACHE/$id.mp4"
  [[ -s "$full" ]] || yt -f "bv*[ext=mp4]+ba[ext=m4a]/bv*[ext=mp4]+ba/b[ext=mp4]/b" --merge-output-format mp4 -o "$full" "$url"
fi

if [[ -z $start && $mp3 == 1 ]]; then
  out="$OUT_DIR/$title.mp3"
  ffmpeg -y -loglevel error -stats -i "$full" -vn -c:a libmp3lame -q:a 2 "$out"
elif [[ -z $start ]]; then
  out="$OUT_DIR/$title.mp4"
  cp "$full" "$out"
elif (( mp3 )); then
  tag="${start//:/m}-${end//:/m}" out="$OUT_DIR/${title}_${tag}.mp3"
  ffmpeg -y -loglevel error -stats -ss "$start" -to "$end" -i "$full" -vn -c:a libmp3lame -q:a 2 "$out"
else
  tag="${start//:/m}-${end//:/m}" out="$OUT_DIR/${title}_${tag}.mp4"
  ffmpeg -y -loglevel error -stats -ss "$start" -to "$end" -i "$full" -c:v libx264 -preset fast -crf 20 -c:a aac "$out"
fi
echo "$out"
