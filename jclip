#!/usr/bin/env bash
# jclip - clip a section of a YouTube video to mp4 (or mp3).
# usage: jclip <url> <start> <end> [--mp3]   e.g. jclip URL 0:20 1:20
set -euo pipefail

OUT_DIR="${JCLIP_DIR:-$HOME/Videos/jclip}"
CACHE="$OUT_DIR/.cache"

[[ $# -ge 3 ]] || { sed -n '2,3p' "$0" | sed 's/^# //'; exit 1; }
url=$1 start=$2 end=$3 mp3=0
[[ "${4:-}" == "--mp3" ]] && mp3=1
for t in yt-dlp ffmpeg; do command -v "$t" >/dev/null || { echo "jclip: missing $t" >&2; exit 1; }; done
mkdir -p "$CACHE"

# Download full video once per id; sectioned downloads truncate audio.
id=$(yt-dlp --get-id "$url")
title=$(yt-dlp --get-title "$url" | tr -c 'A-Za-z0-9._-' '_' | sed 's/_*$//' | cut -c1-60)
full="$CACHE/$id.mp4"
[[ -s "$full" ]] || yt-dlp -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/b" --merge-output-format mp4 -o "$full" "$url"

tag="${start//:/m}-${end//:/m}"
if (( mp3 )); then
  out="$OUT_DIR/${title}_${tag}.mp3"
  ffmpeg -y -loglevel error -stats -ss "$start" -to "$end" -i "$full" -vn -c:a libmp3lame -q:a 2 "$out"
else
  out="$OUT_DIR/${title}_${tag}.mp4"
  ffmpeg -y -loglevel error -stats -ss "$start" -to "$end" -i "$full" -c:v libx264 -preset fast -crf 20 -c:a aac "$out"
fi
echo "$out"
